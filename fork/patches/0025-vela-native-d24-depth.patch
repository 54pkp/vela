+// Optional Vela provider extension for normalized depth sampled in its original format.
+constexpr ffxStructType_t kQueryNativeDepth = 0x56454C4144513031ull; // VELADQ01
+constexpr ffxStructType_t kDispatchNativeDepth = 0x56454C4144443031ull; // VELADD01
+struct QueryNativeDepth
+{
+    ffxApiHeader header;
+    uint32_t supportedFormats;
+};
+struct DispatchNativeDepth
+{
+    ffxApiHeader header;
+    uint32_t depthFormat;
+};
+constexpr uint32_t D24Capability(VkFormat format)
+{
+    switch (format)
+    {
+    case VK_FORMAT_X8_D24_UNORM_PACK32: return 1u << 0;
+    case VK_FORMAT_D24_UNORM_S8_UINT: return 1u << 1;
+    default: return 0;
+    }
+}

